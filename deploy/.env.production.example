# =============================================================================
# Onboardly production settings for a self-hosted VPS.
# Copy to deploy/.env.production (chmod 600). Never commit the real file.
# Values marked (auto) are filled in by deploy/scripts/setup-supabase.sh.
# =============================================================================

# --- Domains (create DNS A records pointing to your VPS first) --------------
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# --- Reverse proxy you already run --------------------------------------------
# PROXY_KIND: traefik (routes are added via container labels) or npm
# (Nginx Proxy Manager: you add two proxy hosts in its web UI).
PROXY_KIND=traefik
# The Docker network your proxy container is attached to (see `docker network ls`).
PROXY_NETWORK=proxy
# Traefik only: names used in YOUR Traefik config.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Supabase gateway on 127.0.0.1 only (for Studio over an SSH tunnel). Pick a free port.
GATEWAY_LOCAL_PORT=18000

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Onboardly

# --- Email (used for login emails AND app emails) ------------------------------
# Any SMTP provider works. Resend SMTP: host smtp.resend.com, port 465,
# user "resend", password = your Resend API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Address emails are sent from (must be on a domain verified with your provider).
SMTP_ADMIN_EMAIL=onboarding@example.com
SMTP_SENDER_NAME=Onboardly
EMAIL_FROM="Onboardly <onboarding@example.com>"
# Optional: send app emails through the Resend API instead of SMTP.
RESEND_API_KEY=

# --- Optional integrations (leave empty until you're ready) --------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SCALE=

# --- Backups -------------------------------------------------------------------
# Daily at this hour (server time, 0-23). Kept for BACKUP_RETENTION_DAYS days.
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

# --- Filled automatically (auto) -----------------------------------------------
CRON_SECRET=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=
