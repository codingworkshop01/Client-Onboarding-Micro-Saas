# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Onboardly

# ---------------------------------------------------------------------------
# Supabase (local defaults come from `pnpm db:start`; replace with your
# hosted project's values in production)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email — Resend in production. If RESEND_API_KEY is empty and SMTP_HOST is set
# (local Mailpit by default), emails go to the local inbox at http://127.0.0.1:54324.
# If neither is configured, emails are logged as "skipped" — never faked.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Onboardly <onboarding@example.com>"
SMTP_HOST=127.0.0.1
SMTP_PORT=54325

# ---------------------------------------------------------------------------
# AI (Anthropic Claude). Leave empty to disable AI features.
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Stripe. Leave empty until you're ready — payment steps will show
# "payments not set up" instead of pretending to work.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# SaaS subscription prices (Stripe Billing) for your own plans
STRIPE_PRICE_SOLO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_SCALE=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Protects /api/cron/* endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=
